{
  "compileOnSave": false,
  "compilerOptions": {
    "outDir": "./dist/out-tsc",
    "rootDir": "..",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "bundler",
    "strict": false,
    "esModuleInterop": true,
    "strictNullChecks": false,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "importHelpers": true,
    "skipLibCheck": true,
    "module": "es2020",
    "target": "ES2022",
    "types": ["jest", "google.accounts"],
    "paths": {
      "upgrade_types": ["../types", "./src/types"],
      "@shared-component-lib": ["./projects/upgrade/src/app/shared-standalone-component-lib/components"],
      "@shared-component-lib/*": ["./projects/upgrade/src/app/shared-standalone-component-lib/components/*"]
    },
    "useDefineForClassFields": false
  }
}
